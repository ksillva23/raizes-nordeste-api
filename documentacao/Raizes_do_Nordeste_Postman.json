      "name": "Autenticação",
      "item": [
        {
          "name": "01 - Login com credenciais válidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\r\n    const resposta = pm.response.json();\r\n\r\n    pm.collectionVariables.set(\r\n        \"token\",\r\n        resposta.access_token\r\n    );\r\n\r\n    console.log(\"Token JWT armazenado com sucesso!\");\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"{{admin_email}}\",\n    \"senha\": \"{{admin_senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://127.0.0.1:8001/auth/login",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "8001",
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
